{
  "name": "ecommerce-platform",
  "version": "2.0.0",
  "description": "E-commerce backend: PostgreSQL + Sequelize, Stripe/PayPal payments, transactional checkout, GraphQL + tRPC + REST, search engines, analytics",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/cli.ts up",
    "migrate:down": "tsx src/db/cli.ts down",
    "migrate:status": "tsx src/db/cli.ts status",
    "migrate:prod": "node dist/db/cli.js up",
    "seed": "tsx src/db/cli.ts seed",
    "seed:prod": "node dist/db/cli.js seed",
    "test": "node --test tests/smoke.test.cjs"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.15.1",
    "@trpc/server": "^11.0.0",
    "algoliasearch": "^4.24.0",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "graphql": "^16.9.0",
    "graphql-http": "^1.22.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "meilisearch": "^0.45.0",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "prom-client": "^15.1.3",
    "sequelize": "^6.37.5",
    "stripe": "^17.3.1",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.2",
    "winston": "^3.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.17",
    "@types/swagger-ui-express": "^4.1.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
