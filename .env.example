NODE_ENV=development
PORT=5000
# Storefront origin(s) allowed by CORS, comma separated; also used for email links and PayPal return URLs
CLIENT_URL=http://localhost:3000,http://localhost:3099
# Public URL of this API (used in campaign tracking links and the OpenAPI document)
PUBLIC_API_URL=http://localhost:5000
LOG_LEVEL=info
# Express "trust proxy" setting (e.g. 1 behind one load balancer) so rate limits and fraud rules see the real client IP
TRUST_PROXY=loopback

# PostgreSQL (DATABASE_URL wins if set)
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_POOL_MAX=10
DB_LOGGING=false
# Run pending migrations on startup (compose does this); otherwise use `npm run migrate`
DB_AUTO_MIGRATE=false
# Optional read replicas for analytics/report queries: postgres://...,postgres://...  (or region|postgres://...)
DB_READ_REPLICAS=
DB_REPLICA_MAX_LAG_SECONDS=30
# Optional analytics-event shards: id=postgres://...,id2=postgres://...  then `npm run migrate:shards`
DB_SHARDS=
CONNECTION_POOL_MAX_SIZE=100
CONNECTION_POOL_LIFETIME=1800000

# Redis (optional; empty = in-process fallback for cache, rate limiting, idempotency, fraud counters, job locks).
# Use Redis whenever more than one API instance runs.
REDIS_URL=
CACHE_DEFAULT_EXPIRATION=300
CACHE_KEY_PREFIX=ecommerce:

# Rate limiting (token bucket per user / IP): burst capacity and tokens per second
RATE_LIMIT_BUCKET_CAPACITY=100
RATE_LIMIT_REFILL_RATE=1.0
RATE_LIMIT_DISABLED=false
AUTH_RATE_LIMIT_PER_MINUTE=10

# Idempotency-Key storage
IDEMPOTENCY_EXPIRATION=86400
IDEMPOTENCY_KEY_PREFIX=idempotency:

# Circuit breaker / retry / timeout for external calls
ERROR_HANDLING_RETRY_COUNT=2
ERROR_HANDLING_EXCEPTIONS_BEFORE_BREAKING=5
ERROR_HANDLING_BREAK_DURATION=30000
ERROR_HANDLING_TIMEOUT=15000

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Payments. "auto" uses Stripe when STRIPE_SECRET_KEY is set, otherwise the local sandbox provider.
PAYMENT_PROVIDER=auto
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BILLING_WEBHOOK_SECRET=
# Point the Stripe client at stripe-mock for local testing (e.g. http://localhost:12111)
STRIPE_API_BASE=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Platform fee kept from each paid order (recorded per charge with the seller payout)
PLATFORM_FEE_PERCENT=10
# Unpaid orders are cancelled (stock released) after this many minutes
ORDER_PAYMENT_TIMEOUT_MINUTES=60

# Membership plans (free shipping). Stripe price ids enable Stripe Billing; without them memberships use the sandbox.
STRIPE_PRICE_MEMBER_MONTHLY=
STRIPE_PRICE_MEMBER_YEARLY=
# Optional JSON override: [{"id":"vip","name":"VIP","price":19,"interval":"month","stripePriceId":null,"perks":["..."]}]
SUBSCRIPTION_PLANS=

# Fraud rules
FRAUD_MAX_ORDERS_PER_HOUR=5
FRAUD_MAX_ORDERS_PER_DEVICE_PER_DAY=15
FRAUD_LARGE_ORDER_AMOUNT=5000
FRAUD_MAX_FAILED_PAYMENTS=3
# Comma-separated ISO country codes whose orders get a high risk score
FRAUD_BLOCKED_COUNTRIES=

# Reviews: only customers who bought the product may review it
REVIEWS_REQUIRE_PURCHASE=false

# Shipping origin (rate zones, Shippo labels)
WAREHOUSE_NAME=E-Commerce Warehouse
WAREHOUSE_STREET=215 Clayton St
WAREHOUSE_CITY=San Francisco
WAREHOUSE_STATE=CA
WAREHOUSE_ZIP=94117
WAREHOUSE_COUNTRY=US

# Email (SMTP). Empty host = emails are logged and kept in the admin outbox instead of sent.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@ecommerce.local
ADMIN_EMAIL=admin@ecommerce.local

# Search engines (each optional; PostgreSQL full-text search is always available and is the fallback)
SEARCH_ENGINE=postgres
ELASTICSEARCH_URL=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ALGOLIA_APP_ID=
ALGOLIA_API_KEY=
MEILISEARCH_URL=
MEILISEARCH_API_KEY=

# Third-party integrations (optional)
SHIPPO_API_TOKEN=
MAILCHIMP_API_KEY=
MAILCHIMP_DATA_CENTER=us1
KLAVIYO_API_KEY=
# HMAC secret for the inbound fulfilment webhook (POST /api/integrations/webhook)
INTEGRATION_WEBHOOK_SECRET=
# Allow outgoing webhooks to private/loopback addresses (local development only)
WEBHOOK_ALLOW_PRIVATE=false

# Background jobs (webhook retries, unpaid order expiry, scheduled campaigns, abandoned carts, sandbox renewals)
JOBS_ENABLED=true
ABANDONED_CART_MINUTES=60

# Capacity planner and constraints report
CAPACITY_CORES_PER_SERVER=4
CAPACITY_MEMORY_PER_SERVER_GB=16
CAPACITY_REDIS_MEMORY_PER_NODE_GB=8
COMPLIANCE_DATA_RETENTION_YEARS=7
COMPLIANCE_REQUIRE_ENCRYPTION=true
COMPLIANCE_REQUIRE_AUDIT_LOGGING=true

# Seed data
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
