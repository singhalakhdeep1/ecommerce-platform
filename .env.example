NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
LOG_LEVEL=info

# PostgreSQL (DATABASE_URL wins if set)
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_POOL_MAX=10
# Optional comma-separated read replicas (postgres://user:pass@host:port/db) used by analytics reads
DB_READ_REPLICAS=
# Optional shards: id=connection-string,id2=connection-string
DB_SHARDS=

# Redis (optional; empty = in-process fallback for cache, rate limiting, idempotency, fraud counters)
REDIS_URL=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Payments. Provider "auto" picks Stripe when STRIPE_SECRET_KEY is set, otherwise the sandbox provider.
PAYMENT_PROVIDER=auto
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BILLING_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Platform fee kept from each paid order (split payments)
PLATFORM_FEE_PERCENT=10

# Email (SMTP). Empty host = emails are logged instead of sent.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@ecommerce.local
ADMIN_EMAIL=admin@ecommerce.local

# Search engines (each optional; PostgreSQL full-text search is always available)
ELASTICSEARCH_URL=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ALGOLIA_APP_ID=
ALGOLIA_API_KEY=
MEILISEARCH_URL=
MEILISEARCH_API_KEY=

# Third-party integrations (optional)
SHIPPO_API_TOKEN=
MAILCHIMP_API_KEY=
MAILCHIMP_DATA_CENTER=us1
KLAVIYO_API_KEY=

# Seed data
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
